# ============================================================================
# NEXUS AI TRAFFIC CONTROL - environment configuration
# Copy this file to `.env` and adjust as needed. Sensible defaults are used
# for every value, so an empty `.env` also works for local development.
# ============================================================================

# ---- Backend ----
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
NEXUS_LOG_LEVEL=INFO
NEXUS_ENV=development

# ---- Frontend ----
# URL the browser uses to reach the backend REST + WebSocket API.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws

# ---- Paths ----
NEXUS_MODELS_DIR=./models
NEXUS_DATA_DIR=./data
NEXUS_DB_URL=sqlite:///./data/nexus.db

# ---- Simulation engine ----
# adapter: "builtin" (pure-python microsimulation, always available)
#          "sumo"    (requires a working SUMO install + libsumo/traci)
NEXUS_SIM_ADAPTER=builtin
# Only used when NEXUS_SIM_ADAPTER=sumo
SUMO_HOME=
NEXUS_SUMO_BINARY=sumo
NEXUS_SUMO_CONFIG=./simulation/networks/intersection.sumocfg

# ---- Runtime config file (all tunables live here) ----
NEXUS_CONFIG_FILE=./configs/config.yaml
